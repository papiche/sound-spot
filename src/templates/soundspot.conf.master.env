# SoundSpot — configuration centrale
# Modifiable sans relancer le script d'installation

SPOT_NAME="${SPOT_NAME}"
SPOT_IP="${SPOT_IP}"
# Plage DHCP attribuée aux visiteurs de l'AP — exclue des vérifications d'accès
# "réseau local de confiance" (voir api/apps/shutdown/run.sh).
DHCP_START="${DHCP_START}"
DHCP_END="${DHCP_END}"
WIFI_SSID="${WIFI_SSID}"
WIFI_CHANNEL="${WIFI_CHANNEL}"
BT_MAC="${BT_MAC}"
BT_MACS="${BT_MACS}"
SNAPCAST_PORT="${SNAPCAST_PORT}"
ICECAST_PORT="8111"
PRESENCE_COOLDOWN="${PRESENCE_COOLDOWN}"
PRESENCE_ENABLED="${PRESENCE_ENABLED}"
INSTALL_DIR="${INSTALL_DIR}"
IFACE_AP="${IFACE_AP}"
# IFACE_WAN est la valeur de secours. soundspot-firewall.sh préfère eth0 si UP,
# puis la route par défaut active (basculement smartphone ↔ routeur transparent).
IFACE_WAN="${IFACE_WAN}"
SOUNDSPOT_USER="${SOUNDSPOT_USER}"
PICOPORT_ENABLED="${PICOPORT_ENABLED}"
# Réseau maillé B.A.T.M.A.N. (dongle USB Wi-Fi 5GHz dédié) — utile seulement pour
# les sites étendus/festivals où un satellite peut sortir de portée de l'AP direct.
MESH_ENABLED="${MESH_ENABLED}"
# AP 5GHz bi-bande (dongle USB Wi-Fi, alternative au mesh) — même SSID que ${SPOT_NAME},
# sous-réseau distinct routé par le Pi. Mutuellement exclusif avec MESH_ENABLED.
AP5G_ENABLED="${AP5G_ENABLED}"
IFACE_AP5G="${IFACE_AP5G}"
AP5G_IP="${AP5G_IP}"
AP5G_DHCP_START="${AP5G_DHCP_START}"
AP5G_DHCP_END="${AP5G_DHCP_END}"

# Mot de passe admin du portail captif — généré aléatoirement à l'install,
# préservé lors des réinstallations (voir install_soundspot.sh).
ADMIN_PASSWORD="${ADMIN_PASSWORD}"

# ── Logs centralisés ─────────────────────────────────────────────
# Niveau de filtre : DEBUG | INFO | WARN | ERROR
# DEBUG active les messages détaillés (boucles, pairs IPFS, frames caméra…)
LOG_LEVEL="${LOG_LEVEL}"
SOUNDSPOT_LOG="${SOUNDSPOT_LOG}"

# ── Clocher numérique ────────────────────────────────────────────
# Intervalle entre annonces quand aucun DJ ne diffuse (secondes).
# Les annonces et le bip 429.62 Hz ne peuvent pas être désactivés.
# Seul le mode horloge (coups de cloche) est configurable via le portail.
IDLE_ANNOUNCE_INTERVAL="900"
# CLOCK_MODE : "bells" (coups de cloche à l'heure) ou "silent" (heure vocale seule)
CLOCK_MODE="bells"

# ── Synthèse vocale Orpheus (si Picoport actif) ──────────────────
# Voix utilisée quand le nœud est connecté à la constellation UPlanet.
# pierre = voix masculine française | amelie = voix féminine française
# Le changement espeak → Orpheus est l'indicateur auditif de connexion.
ORPHEUS_VOICE="pierre"
ORPHEUS_PORT="5005"

# Modes : motion (léger), face (lourd), audio, any
PRESENCE_MODE="motion"
PRESENCE_AUDIO_THRESHOLD="0.08"
# Activer le TTS pour les messages aléatoires au lieu du welcome.wav fixe
PRESENCE_USE_TTS="true"
