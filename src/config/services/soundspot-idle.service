[Unit]
Description=SoundSpot — Clocher numérique (annonces en l'absence de DJ)
After=soundspot-client.service

[Service]
Type=simple
User=${SOUNDSPOT_USER}
EnvironmentFile=${INSTALL_DIR}/soundspot.conf
Environment="XDG_RUNTIME_DIR=/run/user/${SOUNDSPOT_UID}"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${SOUNDSPOT_UID}/bus"
ExecStart=${INSTALL_DIR}/backend/audio/idle_announcer.sh
Restart=always
RestartSec=30
SyslogIdentifier=soundspot-idle
StandardOutput=journal

[Install]
WantedBy=multi-user.target
