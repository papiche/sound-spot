[Unit]
Description=SoundSpot — Golem Distribué (Œil & Oreilles)
After=network-online.target picoport.service
Wants=picoport.service

[Service]
Type=simple
EnvironmentFile=${INSTALL_DIR}/soundspot.conf
Environment="XDG_RUNTIME_DIR=/run/user/${SOUNDSPOT_UID}"
# Droits requis : SOUNDSPOT_USER doit appartenir aux groupes video, render, audio
User=${SOUNDSPOT_USER}
# Tente d'ouvrir le tunnel Ollama avant démarrage (non bloquant si echec)
ExecStartPre=-/bin/bash -c '${USER_HOME}/.local/bin/astrosystemctl connect ollama'
ExecStart=/usr/bin/python3 ${INSTALL_DIR}/backend/video/mon-oeil.py
Restart=always
RestartSec=15
SyslogIdentifier=mon-oeil
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
