[Unit]
Description=SoundSpot — Réseau Maillé B.A.T.M.A.N.-adv
After=network-online.target
Wants=network-online.target
Before=soundspot-client.service snapserver.service icecast2.service
Before=soundspot-client.service snapserver.service icecast2.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Remplace wlan1 par le nom de ton dongle USB Wi-Fi si différent
ExecStart=/opt/soundspot/backend/system/mesh_batman.sh wlan1
ExecStop=/sbin/ip link set dev bat0 down

[Install]
WantedBy=multi-user.target